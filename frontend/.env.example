# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:3001

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Default store slug used only in local development when visiting http://localhost:3000/
# Example: vasco-barber
NEXT_PUBLIC_DEV_DEFAULT_STORE_SLUG=

# Mercado Pago (Checkout Bricks - Public Key for frontend)
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=your-mercadopago-public-key
