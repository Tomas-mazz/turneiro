generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Business model - represents a business/barbershop/salon
model Business {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  category     String // Business category/rubro (barbershop, salon, spa, etc.)
  logo         String?
  coverPhoto       String?
  coverVideo       String?
  coverPhotoMobile String?
  coverVideoMobile String?
  theme        String   @default("DARK") // DARK = fondo oscuro, LIGHT = fondo blanco
  primaryColor String   @default("#000000") // derived from theme for buttons (set on save)
  phone        String?
  email        String?
  address      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  users        User[]
  appointments Appointment[]
  services     Service[]
  workingHours WorkingHours[]
  blockedSlots BlockedSlot[]
  settings     BusinessSettings?
  subscription Subscription?
  employees    Employee[]

  @@index([slug])
}

// Employee model - display profile for booking page (name, photo); admin creates these
model Employee {
  id         String   @id @default(cuid())
  name       String
  photoUrl   String?
  businessId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  isOwner    Boolean  @default(false)
  userId     String?  @unique // optional link to User (STAFF) for dashboard / per-employee flows

  // Relations
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  // In the future, appointments and blocked slots can be scoped per employee
  appointments Appointment[]
  blockedSlots BlockedSlot[]

  @@index([businessId])
  @@index([userId])
}

// User model - authentication for business owners/staff and end clients (USER)
model User {
  id                 String   @id @default(cuid())
  name               String?  // Optional; used for client (USER) registration
  email              String   @unique
  password           String?  // Hashed password; null for OAuth-only users (Google)
  role               String // OWNER, ADMIN, STAFF, USER
  businessId         String?
  googleRefreshToken String? // Google OAuth refresh token for Calendar API
  googleCalendarId   String? // Google Calendar ID (usually "primary")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  business             Business?     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employee             Employee? // STAFF user linked to one employee for dashboard / calendar
  appointmentsSyncedTo Appointment[] // appointments whose GC event was created on this user's calendar

  @@index([email])
  @@index([businessId])
}

model Service {
  id         String   @id @default(cuid())
  name       String
  price      Float
  duration   Int // Duration in minutes (15-120)
  isActive   Boolean  @default(true)
  businessId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  shortDescription String? // Short text shown by default in UI
  description      String? // Extended text shown when user clicks "leer más"
  images           String[] @default([]) // Up to 5 image URLs (enforced in API)

  // Relations
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  subServices  SubService[]

  @@index([businessId])
}

// SubService model - variants/options inside a parent service
model SubService {
  id               String   @id @default(cuid())
  name             String
  price            Float
  duration         Int // Duration in minutes (15-120) specific to this subservice
  isActive         Boolean  @default(true)
  shortDescription String? // Short text shown by default in UI
  description      String? // Extended text shown when user clicks "leer más"
  images           String[] @default([]) // Up to 5 image URLs (enforced in API)
  serviceId        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

// Appointment model - client appointments
model Appointment {
  id                   String   @id @default(cuid())
  startTime            DateTime
  endTime              DateTime
  serviceName          String
  price                Float
  paymentStatus        String // PENDING, PAID, REFUNDED, PARTIALLY_REFUNDED
  paymentProvider      String? // STRIPE, MERCADOPAGO
  paymentIntentId      String? // Stripe Payment Intent ID or Mercado Pago Preference ID
  paymentAmount        Float? // Amount paid (deposit or full)
  paymentHoldExpiresAt DateTime?
  refundAmount         Float? // Amount refunded (if cancelled)
  clientName           String
  clientEmail          String?
  clientPhone          String
  status               String // UPCOMING, COMPLETED, CANCELLED
  cancellationToken    String?  @unique
  cancellationReason   String? // Reason when cancelled by owner (mandatory in UI)
  googleEventId        String? // Google Calendar Event ID for syncing
  syncedToUserId       String? // User whose Google Calendar the event was created in (for per-employee sync)
  ownerCalendarEventId String? // When synced to staff, copy on owner's calendar (for owner view with color); deleted on cancel
  /// When post-payment QStash jobs were first enqueued (avoids duplicate emails if googleEventId is still null).
  paymentConfirmationJobsEnqueuedAt DateTime?
  businessId           String
  employeeId           String?
  serviceId            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  /// When the 2-hour reminder email was successfully sent to the client.
  reminderSentAt       DateTime?

  // Relations
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service      Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  employee     Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  syncedToUser User?     @relation(fields: [syncedToUserId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([startTime])
  @@index([status])
  @@index([cancellationToken])
  @@index([paymentIntentId])
  @@index([googleEventId])
  @@index([syncedToUserId])
}

// WorkingHours model - business working hours per day
model WorkingHours {
  id         String   @id @default(cuid())
  dayOfWeek  Int // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime  String // Format: "HH:MM"
  endTime    String // Format: "HH:MM"
  lunchStart String? // Optional lunch break start
  lunchEnd   String? // Optional lunch break end
  isClosed   Boolean  @default(false)
  businessId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dayOfWeek])
  @@index([businessId])
}

// BlockedSlot model - manually blocked time slots or days
model BlockedSlot {
  id         String   @id @default(cuid())
  date       DateTime @db.Date
  startTime  String? // Format: "HH:MM" (null if FULL_DAY)
  endTime    String? // Format: "HH:MM" (null if FULL_DAY)
  type       String // TIME_SLOT or FULL_DAY
  reason     String?
  businessId String
  // Optional: when set, block applies only to that employee's agenda
  employeeId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([employeeId])
  @@index([date])
}

// BusinessSettings model - business configuration
model BusinessSettings {
  id                               String   @id @default(cuid())
  /// Font family applied to the public booking pages for this business.
  /// Stored as an enum-like string on purpose (keeps migrations simple).
  fontFamily                        String   @default("ROBOTO") // ROBOTO, MONTSERRAT, INTER, POPPINS, NUNITO, PLAYFAIR, ROBOTO_SLAB
  paymentRequired                  Boolean  @default(false)
  paymentOptionalEnabled           Boolean  @default(false)
  paymentType                      String? // PERCENTAGE or FULL
  depositPercentage                Float? // If paymentType is PERCENTAGE
  mercadoPagoPublicKey             String?
  mercadoPagoAccessToken           String?
  mercadoPagoWebhookSecret         String?
  requireRegistrationBeforePayment Boolean  @default(true)
  freeCancellationWindow           Int? // Hours before appointment (e.g., 24)
  cancellationHasCost              Boolean  @default(false)
  lateCancellationFee              Float? // Percentage if cancellationHasCost is true
  bufferTime                       Int? // Legacy: additional buffer minutes between appointments
  slotIntervalMinutes              Int      @default(15) // Base slot interval (15, 20, 30...) for availability generation
  showServiceConfirmModal          Boolean  @default(false) // Show extra confirmation modal after "Confirmar servicio"
  businessId                       String   @unique
  createdAt                        DateTime @default(now())
  updatedAt                        DateTime @updatedAt

  // Relations
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

// Subscription model - business subscription/plan
model Subscription {
  id         String   @id @default(cuid())
  plan       String // FREE, BASIC, PREMIUM
  status     String // ACTIVE, CANCELLED, EXPIRED
  businessId String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}
