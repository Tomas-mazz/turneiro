# Server Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001

# Database (local). For Vercel/production use a cloud DB (Neon, Supabase, etc.)
DATABASE_URL="postgresql://user:password@localhost:5432/appointments"
# Example production: postgresql://user:pass@host.region.aws.neon.tech/dbname?sslmode=require

# Authentication
JWT_SECRET="your-jwt-secret-key"

# First-run: create one ADMIN user on startup only if no admin exists (optional)
# INIT_ADMIN_EMAIL=admin@example.com
# INIT_ADMIN_PASSWORD=your-secure-password

# Twilio WhatsApp
TWILIO_ACCOUNT_SID="your-twilio-sid"
TWILIO_AUTH_TOKEN="your-twilio-token"
TWILIO_WHATSAPP_NUMBER="+14155238886"

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN="your-mercadopago-access-token"
MERCADOPAGO_PUBLIC_KEY="your-mercadopago-public-key"
# Clave secreta del panel Developers → Webhooks (validación x-signature). También se puede guardar por negocio en settings.
MERCADOPAGO_WEBHOOK_SECRET="your-mercadopago-webhook-secret"
# Optional: HTTPS public base for Checkout back_urls only (e.g. ngrok). Overrides FRONTEND_URL; enables auto_return.
# MERCADOPAGO_REDIRECT_BASE_URL=https://xxxx.ngrok-free.app
# Public HTTPS URL of this API for IPN (Mercado Pago must reach it). Falls back to BACKEND_URL.
# BACKEND_PUBLIC_URL=https://api.tudominio.com
# Optional override for notification_url only (same role as BACKEND_PUBLIC_URL).
# MERCADOPAGO_NOTIFICATION_BASE_URL=https://api.tudominio.com
# Extra allowed browser origins for returnOrigin (comma-separated), e.g. www vs apex.
# ALLOWED_RETURN_ORIGINS=https://www.tudominio.com,https://tudominio.com
# Set true to process IPN (requires MERCADOPAGO_WEBHOOK_SECRET or per-business secret in DB).
MERCADOPAGO_WEBHOOK_ENABLED=false

# App Configuration
APP_URL="http://localhost:3000"
APP_TIMEZONE="America/New_York"

# Media Storage (Cloudinary)
# Sign up at https://cloudinary.com, create a cloud, and set these values.
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
# Optional: folder prefix for all uploaded assets
CLOUDINARY_FOLDER="your-cloudinary-folder"

# Google Calendar Integration
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google-calendar/callback"
# Same client can be used for Google Sign-In; redirect for login is BACKEND_URL/api/auth/google/callback
# Add that exact URL to "Authorized redirect URIs" in Google Cloud Console for the OAuth client

# QStash (Upstash) - Background job queue for emails and calendar sync
# Only used when NODE_ENV=production AND QSTASH_BASE_URL is a public URL (not localhost).
# In local development, emails and Google Calendar run synchronously without QStash.
# Sign up at https://console.upstash.com and create a QStash instance
QSTASH_TOKEN="your-qstash-token"
QSTASH_CURRENT_SIGNING_KEY="your-qstash-current-signing-key"
QSTASH_NEXT_SIGNING_KEY="your-qstash-next-signing-key"
# Production API URL (https) that QStash can reach — never use localhost here in prod
# QSTASH_BASE_URL="https://api.yourdomain.com"
